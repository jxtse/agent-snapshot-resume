# Copy to .env and fill in. `asr` loads E2B_*, ASR_*, FC_SANDBOX_* and REGISTRY_* from ./.env (see --env-file).
# Never commit .env, and never pass these values with Harbor's --agent-env / --ae (they would enter the job config).

# --- Sandbox service (E2B-compatible API). For Alibaba Cloud FC sandbox, use the regional endpoints of your account;
#     the key is bound to the region. For e2b.dev, leave E2B_API_URL / E2B_DOMAIN empty.
E2B_API_KEY=
E2B_API_URL=https://api.<region>.e2b.fc.aliyuncs.com
E2B_DOMAIN=<region>.e2b.fc.aliyuncs.com

# --- Private registry for `asr build-template` (only if the task image is private)
REGISTRY_USERNAME=
REGISTRY_PASSWORD=

# --- Model endpoint used by the resumed agent (Anthropic /v1/messages compatible). Base URL WITHOUT /v1/messages.
#     It must be reachable from inside the sandbox.
ASR_UPSTREAM_URL=https://api.anthropic.com
# Read from the Harbor process environment only; it reaches the sandbox through a pipe and lives only in the
# in-sandbox passthrough proxy's memory. Never written to the job config, the bundle, or the snapshot.
ASR_UPSTREAM_KEY=
# Optional: model name for the resumed agent (default: the original run's model).
# ASR_MODEL=
# Sandbox metadata owner tag and template-name prefix (lowercase, digits, '-'). Default: asr
# ASR_OWNER_TAG=asr

# --- Only for a model service inside an Alibaba Cloud VPC without a public address
#     (then use agent_snapshot_resume.sandbox.fc_env:VpcSandboxEnvironment for non-resume jobs).
# FC_SANDBOX_VPC='{"vpcId":"vpc-xxx","vSwitchIds":["vsw-xxx"],"securityGroupId":"sg-xxx"}'
